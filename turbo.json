{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@factory/app#build": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../product.config.ts"],
      "outputs": ["dist/**"]
    },
    "@factory/api#build": {
      "dependsOn": ["^build", "@factory/app#build"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
