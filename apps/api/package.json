{
  "name": "@factory/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787 --var APP_ENV:development --var AUTH_HOSTS:localhost:8787 --var ADMIN_EMAILS:admin@example.com",
    "build": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc --noEmit -p .",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file ../../packages/db/seed/dev.sql",
    "auth:schema": "auth generate --config src/core/auth.cli.ts --output ../../packages/db/src/core/auth-schema.ts -y"
  },
  "dependencies": {
    "@factory/config": "workspace:*",
    "@factory/core": "workspace:*",
    "@factory/db": "workspace:*",
    "@sentry/cloudflare": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "auth": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
