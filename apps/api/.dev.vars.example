# Local secrets for `wrangler dev`. Copy this file to `.dev.vars` (gitignored) and fill it in.
# The human fills real values; agents never read the real file.
# Deployed Workers get the same keys as Wrangler secrets (top level = production, --env preview = preview):
#   pnpm exec wrangler versions secret put <NAME>            and    pnpm exec wrangler versions secret put <NAME> --env preview

# Session signing key, >= 32 random chars. Different per environment.
# Local dev works without it (a fixed dev-only key is used when APP_ENV=development).
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Google sign-in (SETUP_HUMAN.md step 4). Optional: without them the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (SETUP_HUMAN.md step 7). Optional locally: without it, magic links print to the wrangler log.
# Required on production and preview, or sign-in emails fail.
RESEND_API_KEY=
# Sender. Without a verified domain use onboarding@resend.dev (delivers only to the Resend account owner).
MAIL_FROM=Factory Template <onboarding@resend.dev>
# Optional Reply-To on every email (D-067). Unset = legal.contactEmail in product.config.ts. Set it
# only when replies should go elsewhere (MAIL_FROM is often a sending-only subdomain with no inbox).
MAIL_REPLY_TO=

# Duitku sandbox (SETUP_HUMAN.md step 3). Optional locally: without them a fake provider
# simulates payments (/api/dev/fake-pay). Required on preview and production.
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# DUITKU_MODE is a var in wrangler.jsonc ("sandbox"); only the human switches it to "production".

# DOKU Checkout sandbox, only when product.config.ts payments.provider is "doku" (SETUP_HUMAN.md
# step 3b). Back Office > Integration > API Keys: Client ID and the Secret Key (not the Public Key).
# The Notification URL is set per payment channel in the DOKU Back Office:
#   https://<app-host>/api/webhooks/doku
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# DOKU_MODE is a var in wrangler.jsonc ("sandbox"); only the human switches it to "production".

# Pakasir, only when product.config.ts payments.provider is "pakasir" (SETUP_HUMAN.md step 3c, D-092).
# Optional locally: without them an in-memory fake Pakasir API runs the real provider code
# (POST /api/dev/pakasir-pay?paymentId=… plays "the buyer paid"). Project Detail page in
# app.pakasir.com: Slug and API Key at the bottom, the webhook secret at the very bottom.
# The webhook URL is set once per project on that page: https://<app-host>/api/webhooks/pakasir
PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_WEBHOOK_SECRET=
# PAKASIR_MODE is a var in wrangler.jsonc ("sandbox"); only the human switches production to "live".
# Previews always run as sandbox, whatever it says.

# OpenPanel client secret (SETUP_HUMAN step 5). Production only: server-side events (payment
# results from the webhook, renewal reminders from the cron). Not needed locally.
OPENPANEL_CLIENT_SECRET=

# Meta Conversions API (SETUP_HUMAN step 10), only for products with marketing.metaPixelId.
# Production only, and sent only for buyers who allowed ad tracking. Not needed locally.
META_CAPI_TOKEN=
# Events Manager > Test events code, ONLY while testing (remove it afterwards).
META_TEST_EVENT_CODE=

# AI keys: only the one for product.config.ts `ai.provider` is used. Optional locally and on preview:
# without it the product's mock answers (no cost). Production without it answers 503.
# OpenAI (ai.provider "openai", SETUP_HUMAN step 11).
OPENAI_API_KEY=
# OpenRouter (ai.provider "openrouter", D-083, SETUP_HUMAN step 11c).
OPENROUTER_API_KEY=
# Gemini API key from a PAID Google Cloud project (ai.provider "gemini", D-084, SETUP_HUMAN step 11d).
# Never a free-tier key: free-tier content may be read by human reviewers.
GEMINI_API_KEY=
# Optional: try another model without a code change (an OpenAI id or Gemini id with a known price in
# @factory/core/ai, or an OpenRouter slug, whose cost OpenRouter reports).
AI_MODEL=

# Owner alerts on Telegram (product.config.ts `notifications.telegram`, D-112, SETUP_HUMAN step 14).
# Unset = no alerts. Local dev and tests never send, even with these set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
