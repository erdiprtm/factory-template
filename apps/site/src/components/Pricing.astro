---
import { comparedPlan, highlightedPlan, methodChips, perWeekIdr, savingVs } from "@factory/core/pricing";
import { appUrl, formatIdr, product } from "../lib/site";
// Plans come straight from product.config.ts: changing prices needs no code edits. Same framing
// as the app's paywall (D-037): per week, and the highlighted plan's saving.
const best = highlightedPlan(product.plans);
const saving = (plan: (typeof product.plans)[number]) => {
  const base = plan.id === best?.id ? comparedPlan(product.plans, plan) : undefined;
  const s = base ? savingVs(plan, base) : null;
  return s && base ? `Hemat ${formatIdr(s.idr)} (${s.percent}%) dibanding ${base.label}` : null;
};
---

<div class="grid gap-5 sm:grid-cols-2">
  {
    product.plans.map((plan) => (
      <article
        class:list={[
          "flex flex-col gap-4 rounded-lg border bg-card p-6 text-card-foreground",
          plan.id === best?.id ? "border-2 border-primary" : "border-border",
        ]}
      >
        {plan.id === best?.id && (
          <p class="self-start rounded-full bg-accent px-3 py-1 text-xs font-semibold text-accent-foreground">
            Paling hemat
          </p>
        )}
        {saving(plan) && <p class="text-sm font-semibold text-primary">{saving(plan)}</p>}
        <h3 class="text-lg font-semibold">{plan.label}</h3>
        <p class="text-4xl font-extrabold">{formatIdr(plan.priceIdr)}</p>
        <p class="text-sm text-muted-foreground">
          ≈ {formatIdr(perWeekIdr(plan))}/minggu · bayar sekali, tanpa perpanjangan otomatis
        </p>
        <a
          href={`${appUrl}/sign-in`}
          data-event="cta_tap"
          data-plan={plan.id}
          class:list={[
            "mt-auto rounded-lg px-5 py-3 text-center font-semibold",
            plan.id === best?.id ? "bg-primary text-primary-foreground hover:opacity-90" : "border border-input hover:bg-accent",
          ]}
        >
          Pilih {plan.label}
        </a>
      </article>
    ))
  }
</div>
{/* Compact chips (D-098): bank virtual accounts share one, "VA BRI · BNI · BSI". */}
<div class="mt-5 flex flex-wrap items-center justify-center gap-2 text-sm text-muted-foreground" data-testid="pay-methods">
  <span>Bayar dengan</span>
  {methodChips(product.payments.methods).map((m) => <span class="rounded-md border border-border px-2 py-0.5 text-xs font-semibold text-foreground">{m}</span>)}
</div>
{
  product.trial.enabled && (
    <p class="mt-5 text-center text-sm text-muted-foreground">
      Belum yakin? Coba gratis {product.trial.days} hari, satu kali per akun.
    </p>
  )
}
