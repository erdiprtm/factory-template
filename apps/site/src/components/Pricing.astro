---
import { appUrl, formatIdr, product } from "../lib/site";
// Plans come straight from product.config.ts: changing prices needs no code edits.
---

<div class="grid gap-5 sm:grid-cols-2">
  {
    product.plans.map((plan) => (
      <article
        class:list={[
          "flex flex-col gap-4 rounded-lg border bg-card p-6 text-card-foreground",
          plan.highlight ? "border-2 border-primary" : "border-border",
        ]}
      >
        {plan.highlight && (
          <p class="self-start rounded-full bg-accent px-3 py-1 text-xs font-semibold text-accent-foreground">
            Paling hemat
          </p>
        )}
        <h3 class="text-lg font-semibold">{plan.label}</h3>
        <p class="text-4xl font-extrabold">{formatIdr(plan.priceIdr)}</p>
        <p class="text-sm text-muted-foreground">
          {formatIdr(Math.round(plan.priceIdr / plan.months))} / bulan · bayar sekali, tanpa perpanjangan otomatis
        </p>
        <a
          href={`${appUrl}/sign-in`}
          data-event="checkout_started"
          data-plan={plan.id}
          class:list={[
            "mt-auto rounded-lg px-5 py-3 text-center font-semibold",
            plan.highlight ? "bg-primary text-primary-foreground hover:opacity-90" : "border border-input hover:bg-accent",
          ]}
        >
          Pilih {plan.label}
        </a>
      </article>
    ))
  }
</div>
{
  product.trial.enabled && (
    <p class="mt-5 text-center text-sm text-muted-foreground">
      Belum yakin? Coba gratis {product.trial.days} hari, satu kali per akun.
    </p>
  )
}
