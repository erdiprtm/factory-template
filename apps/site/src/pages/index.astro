---
import Faq from "../components/Faq.astro";
import Pricing from "../components/Pricing.astro";
import Base from "../layouts/Base.astro";
import { faqLd, organizationLd, productLd } from "../lib/jsonld";
import { appUrl, faqs, product } from "../lib/site";

const site = Astro.site as URL;
const description = `${product.tagline} Coba gratis ${product.trial.days} hari, lalu pilih paket 6 atau 12 bulan. Bayar dengan QRIS, e-wallet, atau virtual account.`;

// PRODUCT-OWNED copy: replace from the spec. Structure (D-077, /design-review's landing section):
// hero with ONE primary CTA → (proof strip: only true proof, add it once it exists) → one problem
// in the reader's words → at most 3 mechanism points → how it works in 3 steps → pricing → FAQ →
// a close that answers the last doubt, with the SAME CTA label as the hero.
const cta = { label: `Coba gratis ${product.trial.days} hari`, href: `${appUrl}/sign-in` };
const problem = {
  title: "Mau mulai, tapi selalu tertunda?",
  body: "Banyak yang sudah niat, lalu bingung harus mulai dari mana dan berhenti di minggu pertama.",
};
const points = [
  { title: "Mulai dalam hitungan detik", body: "Masuk dengan email atau Google. Tanpa kata sandi." },
  { title: "Bayar sekali, tanpa ribet", body: "QRIS, e-wallet, atau virtual account. Tidak ada tagihan otomatis." },
  { title: "Datamu milikmu", body: "Unduh atau hapus data kapan saja, sesuai UU Pelindungan Data Pribadi." },
];
const steps = [
  { title: "Daftar", body: "Masukkan email, buka tautan yang kami kirim." },
  { title: "Coba gratis", body: `Pakai semua fitur selama ${product.trial.days} hari.` },
  { title: "Pilih paket", body: "Lanjut dengan paket 6 atau 12 bulan kalau cocok." },
];
const ctaClass =
  "inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-primary px-6 font-semibold text-primary-foreground hover:opacity-90 sm:w-auto";
---

<Base title={product.name} description={description} jsonLd={[organizationLd(site), productLd(site), faqLd()]}>
  <section class="mx-auto flex w-full max-w-5xl flex-col items-start gap-6 px-5 py-16 sm:py-24">
    <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{product.tagline}</h1>
    <p class="max-w-2xl text-lg text-muted-foreground">
      {product.name} membantu kamu lebih cepat. Coba gratis {product.trial.days} hari, lalu pilih paket 6 atau 12 bulan.
    </p>
    <div class="flex w-full flex-col items-start gap-4 sm:flex-row sm:items-center">
      <a href={cta.href} data-event="signup_started" data-cta="hero" class={ctaClass}>{cta.label}</a>
      <a href="/harga/" class="inline-flex min-h-11 items-center font-semibold text-primary underline-offset-4 hover:underline">Lihat harga</a>
    </div>
  </section>

  <section class="border-y border-border bg-muted/40" aria-labelledby="masalah">
    <div class="mx-auto grid w-full max-w-5xl gap-10 px-5 py-14 sm:grid-cols-2">
      <div class="flex flex-col gap-3">
        <h2 id="masalah" class="text-3xl font-bold">{problem.title}</h2>
        <p class="text-lg text-muted-foreground">{problem.body}</p>
      </div>
      <ul class="flex flex-col gap-5">
        {
          points.map((p) => (
            <li class="flex flex-col gap-1 border-l-2 border-primary pl-4">
              <h3 class="font-semibold">{p.title}</h3>
              <p class="text-muted-foreground">{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto w-full max-w-5xl px-5 py-14" aria-labelledby="cara">
    <h2 id="cara" class="mb-6 text-3xl font-bold">Cara kerjanya</h2>
    <ol class="grid gap-6 sm:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent font-bold text-accent-foreground" aria-hidden="true">
              {i + 1}
            </span>
            <div class="flex flex-col gap-1">
              <h3 class="font-semibold">{s.title}</h3>
              <p class="text-muted-foreground">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto w-full max-w-5xl px-5 py-14" aria-labelledby="harga">
    <h2 id="harga" class="mb-6 text-3xl font-bold">Harga</h2>
    <Pricing />
  </section>

  <section id="faq" class="mx-auto w-full max-w-3xl px-5 py-14" aria-labelledby="faq-title">
    <h2 id="faq-title" class="mb-6 text-3xl font-bold">Pertanyaan umum</h2>
    <Faq items={faqs} />
  </section>

  <section class="border-t border-border bg-muted/40" aria-labelledby="penutup">
    <div class="mx-auto flex w-full max-w-3xl flex-col items-start gap-4 px-5 py-14">
      <h2 id="penutup" class="text-3xl font-bold">Coba dulu, putuskan nanti</h2>
      <p class="text-lg text-muted-foreground">
        Gratis {product.trial.days} hari tanpa kartu. Kalau tidak cocok, kamu tidak perlu membayar apa pun.
      </p>
      <a href={cta.href} data-event="signup_started" data-cta="close" class={ctaClass}>{cta.label}</a>
    </div>
  </section>
</Base>
