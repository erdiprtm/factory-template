---
import Faq from "../components/Faq.astro";
import Pricing from "../components/Pricing.astro";
import Base from "../layouts/Base.astro";
import { faqLd, organizationLd, productLd } from "../lib/jsonld";
import { appUrl, faqs, product } from "../lib/site";

const site = Astro.site as URL;
const description = `${product.tagline} Coba gratis ${product.trial.days} hari, lalu pilih paket 6 atau 12 bulan. Bayar dengan QRIS, e-wallet, atau virtual account.`;
// PRODUCT-OWNED copy: replace the feature list and hero text per product (from the spec).
const features = [
  { title: "Mulai dalam hitungan detik", body: "Masuk dengan email atau Google. Tanpa kata sandi." },
  { title: "Bayar sekali, tanpa ribet", body: "QRIS, e-wallet, atau virtual account. Tidak ada tagihan otomatis." },
  { title: "Datamu milikmu", body: "Unduh atau hapus data kapan saja, sesuai UU Pelindungan Data Pribadi." },
];
---

<Base title={product.name} description={description} jsonLd={[organizationLd(site), productLd(site), faqLd()]}>
  <section class="mx-auto flex w-full max-w-5xl flex-col items-start gap-6 px-5 py-16 sm:py-24">
    <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{product.tagline}</h1>
    <p class="max-w-2xl text-lg text-muted-foreground">
      {product.name} membantu kamu lebih cepat. Coba gratis {product.trial.days} hari, lalu pilih paket 6 atau 12 bulan.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href={`${appUrl}/sign-in`} data-event="signup_started" class="rounded-lg bg-primary px-6 py-3 font-semibold text-primary-foreground hover:opacity-90">
        Coba gratis {product.trial.days} hari
      </a>
      <a href="/harga/" class="rounded-lg border border-input px-6 py-3 font-semibold hover:bg-accent">Lihat harga</a>
    </div>
  </section>

  <section class="border-y border-border bg-muted/40">
    <div class="mx-auto grid w-full max-w-5xl gap-6 px-5 py-14 sm:grid-cols-3">
      {
        features.map((f) => (
          <div class="flex flex-col gap-2">
            <h2 class="text-lg font-semibold">{f.title}</h2>
            <p class="text-muted-foreground">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto w-full max-w-5xl px-5 py-14" aria-labelledby="harga">
    <h2 id="harga" class="mb-6 text-3xl font-bold">Harga</h2>
    <Pricing />
  </section>

  <section id="faq" class="mx-auto w-full max-w-3xl px-5 py-14" aria-labelledby="faq-title">
    <h2 id="faq-title" class="mb-6 text-3xl font-bold">Pertanyaan umum</h2>
    <Faq items={faqs} />
  </section>
</Base>
