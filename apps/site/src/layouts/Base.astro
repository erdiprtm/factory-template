---
import "../styles/global.css";
import { colorSchemeHead } from "../lib/color-scheme.mjs";
import { analyticsClientId, appUrl, homeUrl, metaPixelId, product } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** Path of the OG image under /og/, e.g. "home" → /og/home.png */
  og?: string;
  jsonLd?: unknown[];
  /** Standard analytics event fired on load (Section 9), e.g. "pricing_view"; landers send "lp_view". */
  event?: "site_view" | "pricing_view" | "lp_view";
  /** Ad landers: logo-only header (one way forward: the CTA) and kept out of search. */
  minimal?: boolean;
}

const { title, description, og = "home", jsonLd = [], event = "site_view", minimal = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${og}.png`, Astro.site);
const fullTitle = title === product.name ? title : `${title} | ${product.name}`;
const year = new Date().getFullYear();
const scheme = colorSchemeHead(product.brand.darkMode);
---

<!doctype html>
<html lang={product.locale.default}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {minimal && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href={product.brand.favicon} type="image/svg+xml" />
    <meta name="theme-color" content={product.brand.tokens.colors.light.primary} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={product.locale.default === "id" ? "id_ID" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
    {scheme.colorScheme && <meta name="color-scheme" content={scheme.colorScheme} />}
    <!-- Apply dark mode before paint (follows the device; no flash). Light-only products skip it (D-076). -->
    {scheme.themeScript && <script is:inline src="/theme.js"></script>}
  </head>
  <body class="flex min-h-screen flex-col" data-page-event={event} data-op-client={analyticsClientId} data-app-url={appUrl} data-meta-pixel={metaPixelId}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-md focus:bg-background focus:p-2">Langsung ke konten</a>
    <header class="border-b border-border">
      <nav class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-5 py-4" aria-label="Utama">
        <a href={homeUrl} class="inline-flex min-h-11 items-center text-lg font-bold">{product.name}</a>
        {
          !minimal && (
            <div class="flex items-center gap-1 text-sm sm:gap-2">
              {/* 44 px tap targets; "Masuk" is outlined so the page's own CTA is the one filled button (D-077). */}
              <a href="/harga/" class="inline-flex min-h-11 items-center rounded-md px-3 text-muted-foreground hover:text-foreground">Harga</a>
              <a href="/harga/#faq" class="hidden min-h-11 items-center rounded-md px-3 text-muted-foreground hover:text-foreground sm:inline-flex">FAQ</a>
              <a href={`${appUrl}/sign-in`} data-event="signup_started" class="inline-flex min-h-11 items-center rounded-lg border border-input px-4 font-semibold hover:bg-accent">Masuk</a>
            </div>
          )
        }
      </nav>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-border">
      <div class="mx-auto flex w-full max-w-5xl flex-col gap-3 px-5 py-8 text-sm text-muted-foreground sm:flex-row sm:justify-between">
        <p>© {year} {product.legal.companyName}</p>
        <nav class="flex flex-wrap gap-4" aria-label="Legal">
          <a href="/privasi/" class="hover:text-foreground">Kebijakan Privasi</a>
          <a href="/syarat/" class="hover:text-foreground">Syarat & Ketentuan</a>
          <a href="/kontak/" class="hover:text-foreground">Kontak</a>
        </nav>
      </div>
    </footer>
    {
      metaPixelId && (
        <div id="consent-banner" hidden role="region" aria-label="Privasi & iklan" class="fixed inset-x-0 bottom-0 z-50 border-t border-border bg-card p-4 shadow-lg">
          <div class="mx-auto flex max-w-5xl flex-col gap-3 text-sm">
            <p class="font-semibold">Privasi & iklan</p>
            <p class="text-muted-foreground">
              Kami memakai analitik anonim untuk memperbaiki layanan. Dengan izinmu, kami juga memakai Meta Pixel untuk mengukur iklan kami di Facebook dan Instagram. Pilihan ini bisa diubah kapan saja. <a href="/privasi/" class="underline">Kebijakan Privasi</a>
            </p>
            <label class="flex min-h-11 items-center gap-3">
              <input id="consent-ads" type="checkbox" class="h-5 w-5" />
              <span>Izinkan pelacakan iklan (Meta)</span>
            </label>
            <button id="consent-save" type="button" class="min-h-11 self-start rounded-lg bg-primary px-5 font-semibold text-primary-foreground">Simpan pilihan</button>
          </div>
        </div>
      )
    }
    <script>
      // Standard events (Section 9) to OpenPanel. Bundled by Astro into a file (CSP: script-src 'self').
      // data-op-client is set only on production builds with a client ID; otherwise this is a no-op.
      import {
        createAnalytics,
        isClientFunnelEvent,
        noopAnalytics,
        openPanelProvider,
        type StandardEvent,
      } from "@factory/core/analytics";
      import { parseTouch, resolveTouch, withTouch } from "@factory/core/attribution/touch";
      import {
        choiceToParam,
        loadPixel,
        MARKETING_KEY,
        MARKETING_PARAM,
        type MarketingChoice,
        parseChoice,
        pixelTrack,
      } from "@factory/core/meta/events";
      import { OpenPanel } from "@openpanel/web";

      const { opClient: clientId, appUrl = "", metaPixel } = document.body.dataset;
      const analytics = createAnalytics(
        clientId ? openPanelProvider(new OpenPanel({ clientId, trackOutgoingLinks: true })) : noopAnalytics,
      );

      // First-touch attribution (D-033): kept on this device and handed to the app in its links,
      // so the app keeps the same anonId and UTM tags (the site and the app are different origins).
      let stored = null;
      try {
        stored = window.localStorage.getItem("factory.touch");
      } catch {}
      const touch = resolveTouch(parseTouch(stored), window.location.href);
      try {
        window.localStorage.setItem("factory.touch", JSON.stringify(touch));
      } catch {}
      // Marketing consent (UU PDP, D-034): no choice = no Pixel. The choice rides along into the app.
      const readChoice = (): MarketingChoice | null => {
        try {
          return parseChoice(JSON.parse(window.localStorage.getItem(MARKETING_KEY) ?? "null")?.choice);
        } catch {
          return null;
        }
      };
      let choice = metaPixel ? readChoice() : null;
      const decorateLinks = () => {
        for (const a of document.querySelectorAll("a[href]")) {
          if (!(a instanceof HTMLAnchorElement) || !appUrl || !a.href.startsWith(appUrl)) continue;
          const url = new URL(withTouch(a.href, touch));
          if (choice) url.searchParams.set(MARKETING_PARAM, choiceToParam(choice));
          a.href = url.toString();
        }
      };
      decorateLinks();
      if (metaPixel && choice === "granted") loadPixel(metaPixel);
      const banner = document.getElementById("consent-banner");
      if (metaPixel && banner && !choice) {
        banner.hidden = false;
        document.getElementById("consent-save")?.addEventListener("click", () => {
          const ads = document.getElementById("consent-ads");
          choice = ads instanceof HTMLInputElement && ads.checked ? "granted" : "denied";
          try {
            window.localStorage.setItem(MARKETING_KEY, JSON.stringify({ choice, synced: false }));
          } catch {}
          banner.hidden = true;
          decorateLinks();
          if (choice === "granted") {
            loadPixel(metaPixel);
            pixelTrack(document.body.dataset.pageEvent ?? "");
          }
        });
      }

      // Funnel steps are also stored first-party by the app's API. sendBeacon with text/plain is
      // a simple cross-origin request (no preflight) and survives the navigation a CTA starts.
      const funnel = (event: string) => {
        if (!appUrl || !isClientFunnelEvent(event)) return;
        const body = JSON.stringify({
          anonId: touch.anonId,
          utm_source: touch.utm_source,
          utm_campaign: touch.utm_campaign,
          events: [{ event }],
        });
        try {
          navigator.sendBeacon(`${appUrl}/api/events`, new Blob([body], { type: "text/plain" }));
        } catch {}
      };
      const track = (event: string, props?: Record<string, string>) => {
        analytics.track(event as StandardEvent, props);
        funnel(event);
        pixelTrack(event); // no-op unless the Pixel loaded (consent)
      };

      track(document.body.dataset.pageEvent ?? "site_view");
      for (const el of document.querySelectorAll("[data-event]")) {
        if (!(el instanceof HTMLElement)) continue;
        el.addEventListener("click", () =>
          track(el.dataset.event ?? "", el.dataset.plan ? { plan: el.dataset.plan } : undefined),
        );
      }
    </script>
  </body>
</html>
