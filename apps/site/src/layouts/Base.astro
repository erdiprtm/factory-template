---
import "../styles/global.css";
import { colorSchemeHead } from "../lib/color-scheme.mjs";
import { pathToFileURL } from "node:url";
import { logoSize } from "../lib/logo.mjs";
import { analyticsClientId, appUrl, clarityProjectId, homeUrl, metaPixelId, product, siteAsksConsent } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** Path of the OG image under /og/, e.g. "home" → /og/home.png */
  og?: string;
  jsonLd?: unknown[];
  /** Standard analytics event fired on load (Section 9), e.g. "pricing_view"; landers send "lp_view". */
  event?: "site_view" | "pricing_view" | "lp_view";
  /** Ad landers: logo-only header (one way forward: the CTA) and kept out of search. */
  minimal?: boolean;
}

const { title, description, og = "home", jsonLd = [], event = "site_view", minimal = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${og}.png`, Astro.site);
const fullTitle = title === product.name ? title : `${title} | ${product.name}`;
const year = new Date().getFullYear();
const scheme = colorSchemeHead(product.brand.darkMode);
// The marketing ask (D-107): only on a first visit to the site, in the product's words if it has
// them. With askAt "after_first_result" or "after_signup" the app asks later, so the site asks only
// on the pages under consent.siteAskPaths (D-132).
const consentAsk = siteAsksConsent(Astro.url.pathname, { metaPixelId, consent: product.marketing.consent });
const allowPrimary = product.marketing.consent.allowStyle === "primary";
// D-134: "sheet" must be answered before the page can be used; "bar" (default) can be ignored.
// D-135: "sticky" looks like the sheet and stays until answered, but never locks the page.
const consentMode = product.marketing.consent.siteAskMode;
const consentSheet = consentMode === "sheet";
const consentSheetLook = consentMode === "sheet" || consentMode === "sticky";
const consentCopy = {
  title: "Privasi & iklan",
  // D-137: with Clarity, the default words also say what "Izinkan" turns on there.
  body: product.analytics.clarityProjectId
    ? "Kami memakai analitik anonim untuk memperbaiki layanan. Dengan izinmu, kami juga memakai Meta Pixel untuk mengukur iklan kami di Facebook dan Instagram, dan cookie Microsoft Clarity untuk memahami cara halaman dipakai. Pilihan ini bisa diubah kapan saja."
    : "Kami memakai analitik anonim untuk memperbaiki layanan. Dengan izinmu, kami juga memakai Meta Pixel untuk mengukur iklan kami di Facebook dan Instagram. Pilihan ini bisa diubah kapan saja.",
  allow: "Izinkan",
  deny: "Tidak, terima kasih",
  ...product.marketing.consent.copy[product.locale.default],
};
// Header (D-096): the name as text, the logo, or both; the logo's width is read from the served file.
const { show, logoHeight } = product.brand.header;
// Astro builds from apps/site (pnpm --filter), so public/ is relative to the working directory.
const logo = show === "name" ? null : logoSize(pathToFileURL(`${process.cwd()}/public/`), product.brand.logo, logoHeight);
---

<!doctype html>
<html lang={product.locale.default}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {minimal && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* PNG and ICO first (written by pnpm theme, D-096) for browsers and crawlers without SVG favicons. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" href={product.brand.favicon} type="image/svg+xml" />
    <meta name="theme-color" content={product.brand.tokens.colors.light.primary} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={product.locale.default === "id" ? "id_ID" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
    {scheme.colorScheme && <meta name="color-scheme" content={scheme.colorScheme} />}
    <!-- Apply dark mode before paint (follows the device; no flash). Light-only products skip it (D-076). -->
    {scheme.themeScript && <script is:inline src="/theme.js"></script>}
  </head>
  <body class="flex min-h-screen flex-col" data-page-event={event} data-op-client={analyticsClientId} data-app-url={appUrl} data-meta-pixel={metaPixelId} data-clarity={clarityProjectId} data-clarity-cookieless={clarityProjectId && product.analytics.clarityCookieless ? "1" : undefined}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-md focus:bg-background focus:p-2">Langsung ke konten</a>
    <header class="border-b border-border">
      <nav class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-5 py-4" aria-label="Utama">
        <a href={homeUrl} class="inline-flex min-h-11 items-center gap-2 text-lg font-bold">
          {/* Logo only: its alt is the name. With the name beside it, the image is decorative. */}
          {logo && <img src={product.brand.logo} alt={show === "logo" ? product.name : ""} width={logo.width ?? undefined} height={logo.height} style={`height:${logo.height}px;width:auto`} />}
          {show !== "logo" && product.name}
        </a>
        {
          !minimal && (
            <div class="flex items-center gap-1 text-sm sm:gap-2">
              {/* 44 px tap targets; "Masuk" is outlined so the page's own CTA is the one filled button (D-077). */}
              <a href="/harga/" class="inline-flex min-h-11 items-center rounded-md px-3 text-muted-foreground hover:text-foreground">Harga</a>
              <a href="/harga/#faq" class="hidden min-h-11 items-center rounded-md px-3 text-muted-foreground hover:text-foreground sm:inline-flex">FAQ</a>
              <a href={`${appUrl}/sign-in`} data-event="signup_started" class="inline-flex min-h-11 items-center rounded-lg border border-input px-4 font-semibold hover:bg-accent">Masuk</a>
            </div>
          )
        }
      </nav>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-border">
      <div class="mx-auto flex w-full max-w-5xl flex-col gap-3 px-5 py-8 text-sm text-muted-foreground sm:flex-row sm:justify-between">
        <p>© {year} {product.legal.companyName}</p>
        <nav class="flex flex-wrap gap-4" aria-label="Legal">
          <a href="/privasi/" class="hover:text-foreground">Kebijakan Privasi</a>
          <a href="/syarat/" class="hover:text-foreground">Syarat & Ketentuan</a>
          <a href="/kontak/" class="hover:text-foreground">Kontak</a>
        </nav>
      </div>
    </footer>
    {
      consentAsk && consentSheet && (
        <div id="consent-backdrop" hidden aria-hidden="true" class="fixed inset-0 z-[59] bg-black/30" />
      )
    }
    {
      consentAsk && (
        <div
          id="consent-banner"
          hidden
          data-mode={consentMode}
          role={consentSheet ? "dialog" : "region"}
          aria-modal={consentSheet ? "true" : undefined}
          aria-label={consentCopy.title}
          class:list={[
            "fixed inset-x-0 bottom-0 z-[60] border-t border-border bg-card p-4 shadow-lg",
            consentSheetLook && "rounded-t-2xl px-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-5",
            consentSheet && "min-h-[25vh]",
          ]}
        >
          <div class:list={["mx-auto flex max-w-5xl flex-col gap-3", consentSheetLook ? "text-base" : "text-sm"]}>
            <p class="font-semibold">{consentCopy.title}</p>
            <p class="text-muted-foreground">
              {consentCopy.body} <a href="/privasi/" class="underline">Kebijakan Privasi</a>
            </p>
            {/* Same size, one tap each, nothing pre-selected (D-107). allowStyle "primary" (D-132) fills "Izinkan". */}
            <div class="flex gap-3">
              <button id="consent-deny" type="button" class="min-h-11 flex-1 rounded-lg border border-input px-4 font-semibold hover:bg-accent">{consentCopy.deny}</button>
              <button id="consent-allow" type="button" class:list={["min-h-11 flex-1 rounded-lg border px-4 font-semibold", allowPrimary ? "border-primary bg-primary text-primary-foreground hover:opacity-90" : "border-input hover:bg-accent"]}>{consentCopy.allow}</button>
            </div>
          </div>
        </div>
      )
    }
    <script>
      // Standard events (Section 9) to OpenPanel. Bundled by Astro into a file (CSP: script-src 'self').
      // data-op-client is set only on production builds with a client ID; otherwise this is a no-op.
      import {
        createAnalytics,
        isClientFunnelEvent,
        noopAnalytics,
        openPanelProvider,
        type StandardEvent,
      } from "@factory/core/analytics";
      import { loadClarity, setClarityConsent } from "@factory/core/analytics/clarity";
      import { parseTouch, resolveTouch, withTouch } from "@factory/core/attribution/touch";
      import {
        choiceToParam,
        loadPixel,
        MARKETING_KEY,
        MARKETING_PARAM,
        type MarketingChoice,
        parseChoice,
        pixelTrack,
      } from "@factory/core/meta/events";
      import { OpenPanel } from "@openpanel/web";

      const { opClient: clientId, appUrl = "", metaPixel, clarity: clarityId, clarityCookieless } = document.body.dataset;
      const analytics = createAnalytics(
        clientId ? openPanelProvider(new OpenPanel({ clientId, trackOutgoingLinks: true })) : noopAnalytics,
      );

      // First-touch attribution (D-033): kept on this device and handed to the app in its links,
      // so the app keeps the same anonId and UTM tags (the site and the app are different origins).
      let stored = null;
      try {
        stored = window.localStorage.getItem("factory.touch");
      } catch {}
      const touch = resolveTouch(parseTouch(stored), window.location.href);
      try {
        window.localStorage.setItem("factory.touch", JSON.stringify(touch));
      } catch {}
      // Marketing consent (UU PDP, D-034): no choice = no Pixel. The choice rides along into the app.
      const readChoice = (): MarketingChoice | null => {
        try {
          return parseChoice(JSON.parse(window.localStorage.getItem(MARKETING_KEY) ?? "null")?.choice);
        } catch {
          return null;
        }
      };
      let choice = metaPixel ? readChoice() : null;
      const decorateLinks = () => {
        for (const a of document.querySelectorAll("a[href]")) {
          if (!(a instanceof HTMLAnchorElement) || !appUrl || !a.href.startsWith(appUrl)) continue;
          const url = new URL(withTouch(a.href, touch));
          if (choice) url.searchParams.set(MARKETING_PARAM, choiceToParam(choice));
          a.href = url.toString();
        }
      };
      decorateLinks();
      if (metaPixel && choice === "granted") loadPixel(metaPixel);
      // Microsoft Clarity (D-137): loaded only after "Izinkan", like the Pixel. Loading it with
      // consent denied still set Microsoft cookies (CLID from the tag, MUID via a Bing sync).
      const startClarity = () => {
        if (clarityId && loadClarity(clarityId, window as never)) setClarityConsent(true, window as never);
      };
      // clarityCookieless (only with cookies OFF in the Clarity project, re-tested 2026-11-23): every
      // visitor, consent denied first (no cookies at all); "Izinkan" then grants analytics only.
      if (clarityId && clarityCookieless) {
        loadClarity(clarityId, window as never);
        if (choice === "granted") setClarityConsent(true, window as never);
      } else if (choice === "granted") startClarity();
      // The banner exists only when the product asks on a first visit (D-107).
      const banner = document.getElementById("consent-banner");
      const asking = Boolean(metaPixel && banner && !choice);
      if (asking && banner) {
        banner.hidden = false;
        // D-134 "sheet": the dimmed page can't be clicked or scrolled until a choice is made. The
        // lock is only overflow on <html>/<body> plus a touchmove guard on the backdrop (iOS WebKit,
        // Instagram's browser), and all of it is undone the moment a button is tapped.
        const sheet = banner.dataset.mode === "sheet";
        const backdrop = document.getElementById("consent-backdrop");
        const root = document.documentElement;
        const before = { html: root.style.overflow, body: document.body.style.overflow };
        const stopTouch = (e: Event) => e.preventDefault();
        if (sheet) {
          if (backdrop) backdrop.hidden = false;
          root.style.overflow = "hidden";
          document.body.style.overflow = "hidden";
          backdrop?.addEventListener("touchmove", stopTouch, { passive: false });
          document.getElementById("consent-allow")?.focus({ preventScroll: true });
        }
        // D-135 "sticky": no lock, no dim. While it's open the page gets bottom padding as tall as the
        // sheet (measured, and re-measured if it changes), so the last content and CTAs stay tappable.
        const sticky = banner.dataset.mode === "sticky";
        const padBefore = document.body.style.paddingBottom;
        const pad = () => {
          document.body.style.paddingBottom = `${Math.ceil(banner.getBoundingClientRect().height)}px`;
        };
        const resize = sticky && "ResizeObserver" in window ? new ResizeObserver(pad) : null;
        if (sticky) {
          pad();
          resize?.observe(banner);
        }
        const unlock = () => {
          if (sticky) {
            resize?.disconnect();
            document.body.style.paddingBottom = padBefore;
          }
          if (!sheet) return;
          if (backdrop) backdrop.hidden = true;
          root.style.overflow = before.html;
          document.body.style.overflow = before.body;
          backdrop?.removeEventListener("touchmove", stopTouch);
        };
        const choose = (picked: MarketingChoice) => {
          unlock();
          choice = picked;
          try {
            window.localStorage.setItem(MARKETING_KEY, JSON.stringify({ choice, synced: false }));
          } catch {}
          banner.hidden = true;
          decorateLinks();
          funnel(picked === "granted" ? "consent_granted" : "consent_denied");
          if (clarityId && clarityCookieless) setClarityConsent(picked === "granted", window as never);
          else if (picked === "granted") startClarity();
          if (picked === "granted" && metaPixel) {
            loadPixel(metaPixel);
            pixelTrack(document.body.dataset.pageEvent ?? "");
          }
        };
        document.getElementById("consent-allow")?.addEventListener("click", () => choose("granted"));
        document.getElementById("consent-deny")?.addEventListener("click", () => choose("denied"));
      }

      // Funnel steps are also stored first-party by the app's API. sendBeacon with text/plain is
      // a simple cross-origin request (no preflight) and survives the navigation a CTA starts.
      const funnel = (event: string) => {
        if (!appUrl || !isClientFunnelEvent(event)) return;
        const body = JSON.stringify({
          anonId: touch.anonId,
          utm_source: touch.utm_source,
          utm_campaign: touch.utm_campaign,
          utm_content: touch.utm_content,
          path: location.pathname.slice(0, 200), // D-133: per-page funnels; never the query
          events: [{ event }],
        });
        try {
          navigator.sendBeacon(`${appUrl}/api/events`, new Blob([body], { type: "text/plain" }));
        } catch {}
      };
      const track = (event: string, props?: Record<string, string>) => {
        analytics.track(event as StandardEvent, props);
        funnel(event);
        pixelTrack(event); // no-op unless the Pixel loaded (consent)
      };

      const pageEvent = document.body.dataset.pageEvent ?? "site_view";
      track(pageEvent);
      // Every page but an ad lander is also a first-party visit (D-117), e.g. /harga's pricing_view
      // page, so organic visitors count. D1 only: no OpenPanel duplicate, no Meta event.
      if (pageEvent !== "lp_view" && pageEvent !== "site_view") funnel("site_view");
      // Counted once per device (first-party, D-107); the app shares the key on one domain.
      try {
        if (asking && !window.localStorage.getItem("factory.consent.shown")) {
          window.localStorage.setItem("factory.consent.shown", "1");
          funnel("consent_shown");
        }
      } catch {}
      for (const el of document.querySelectorAll("[data-event]")) {
        if (!(el instanceof HTMLElement)) continue;
        el.addEventListener("click", () =>
          track(el.dataset.event ?? "", el.dataset.plan ? { plan: el.dataset.plan } : undefined),
        );
      }
    </script>
  </body>
</html>
