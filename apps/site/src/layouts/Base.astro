---
import "../styles/global.css";
import { analyticsClientId, appUrl, product } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** Path of the OG image under /og/, e.g. "home" → /og/home.png */
  og?: string;
  jsonLd?: unknown[];
  /** Standard analytics event fired on load (Section 9), e.g. "pricing_view". */
  event?: "site_view" | "pricing_view";
}

const { title, description, og = "home", jsonLd = [], event = "site_view" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${og}.png`, Astro.site);
const fullTitle = title === product.name ? title : `${title} | ${product.name}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={product.locale.default}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href={product.brand.favicon} type="image/svg+xml" />
    <meta name="theme-color" content={product.brand.tokens.colors.light.primary} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={product.locale.default === "id" ? "id_ID" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
    <!-- Apply dark mode before paint (follows the device; no flash). -->
    <script is:inline src="/theme.js"></script>
  </head>
  <body class="flex min-h-screen flex-col" data-page-event={event} data-op-client={analyticsClientId}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-md focus:bg-background focus:p-2">Langsung ke konten</a>
    <header class="border-b border-border">
      <nav class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-5 py-4" aria-label="Utama">
        <a href="/" class="text-lg font-bold">{product.name}</a>
        <div class="flex items-center gap-1 text-sm sm:gap-4">
          <a href="/harga/" class="rounded-md px-2 py-2 text-muted-foreground hover:text-foreground">Harga</a>
          <a href="/#faq" class="hidden rounded-md px-2 py-2 text-muted-foreground hover:text-foreground sm:inline">FAQ</a>
          <a href={`${appUrl}/sign-in`} data-event="signup_started" class="rounded-lg bg-primary px-4 py-2 font-semibold text-primary-foreground hover:opacity-90">Masuk</a>
        </div>
      </nav>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-border">
      <div class="mx-auto flex w-full max-w-5xl flex-col gap-3 px-5 py-8 text-sm text-muted-foreground sm:flex-row sm:justify-between">
        <p>© {year} {product.legal.companyName}</p>
        <nav class="flex flex-wrap gap-4" aria-label="Legal">
          <a href="/privasi/" class="hover:text-foreground">Kebijakan Privasi</a>
          <a href="/syarat/" class="hover:text-foreground">Syarat & Ketentuan</a>
          <a href="/kontak/" class="hover:text-foreground">Kontak</a>
        </nav>
      </div>
    </footer>
    <script>
      // Standard events (Section 9) to OpenPanel. Bundled by Astro into a file (CSP: script-src 'self').
      // data-op-client is set only on production builds with a client ID; otherwise this is a no-op.
      import { createAnalytics, noopAnalytics, openPanelProvider, type StandardEvent } from "@factory/core/analytics";
      import { OpenPanel } from "@openpanel/web";

      const clientId = document.body.dataset.opClient;
      const analytics = createAnalytics(
        clientId ? openPanelProvider(new OpenPanel({ clientId, trackOutgoingLinks: true })) : noopAnalytics,
      );
      analytics.track((document.body.dataset.pageEvent ?? "site_view") as StandardEvent);
      for (const el of document.querySelectorAll("[data-event]")) {
        if (!(el instanceof HTMLElement)) continue;
        el.addEventListener("click", () =>
          analytics.track(
            (el.dataset.event ?? "") as StandardEvent,
            el.dataset.plan ? { plan: el.dataset.plan } : undefined,
          ),
        );
      }
    </script>
  </body>
</html>
