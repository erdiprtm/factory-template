{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The static Astro build, plus a tiny script only for /_astro/* (D-138: immutable only for a real
  // file, never for a 404 during a deploy). Top level = PRODUCTION, env.preview = per-PR previews.
  // Production changes only through CI.
  "name": "factory-template-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/_astro/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // One domain (D-068, D-069; docs/SETUP_HUMAN.md "Satu domain"): the app Worker owns the host
  // (Custom Domain, set in the dashboard) and "routes" here send the site's paths to this Worker, e.g.
  //   { "pattern": "app.example.id/harga*", "zone_name": "example.id" }
  // test/one-domain.test.ts lists any that are missing or that would shadow an app screen.
  "env": {
    // Routes are inherited: previews never take the production domain.
    "preview": { "routes": [] }
  }
}
